    "synapse": "primary somatosensory cortex BA 3,1,2",
    "level": "thalamus",
    "decussates": false
   }
  ],
  "decussation": "Caudal medulla (internal arcuate fibers)",
  "lesion": {
   "below_decussation": "ipsilateral loss",
   "above": "contralateral loss"
  },
