 "version": 1,
 "note": "Curated from content/nsci3250/structures.json info.facts.supply plus standard neuroanatomy. Mesh ids are Z-Anatomy / registered MNI atlas ids (public/atlas/index.json). The first artery of a unit is the one it is coloured by.",
 "arteries": [
  {
   "id": "aca",
   "name": "Anterior cerebral artery",
   "short": "ACA",
   "color": "#ef476f",
   "territory": "Medial frontal and parietal lobes (to about the parieto-occipital sulcus), cingulate gyrus and basal forebrain; lower-extremity motor and sensory areas. Branches: pericallosal and callosomarginal arteries. The medial striate artery (recurrent artery of Heubner) supplies part of the anterior limb of the internal capsule and adjacent basal ganglia."
  },
  {
   "id": "mca",
   "name": "Middle cerebral artery",
   "short": "MCA",
   "color": "#ffa62b",
   "territory": "Most of the lateral frontal, parietal and temporal lobes: face and upper-extremity motor and sensory areas, speech (Broca) and auditory cortex. Via the lenticulostriate arteries: basal ganglia and the anterior limb of the internal capsule."
  },
  {
   "id": "pca",
   "name": "Posterior cerebral artery",
   "short": "PCA",
   "color": "#3a86ff",
   "territory": "Inferior half of the temporal lobe and the occipital lobe (vision, the 'what' pathway); thalamus and posterior limb of the internal capsule; rostral pons, midbrain and diencephalon through penetrating and circumferential branches."
  },
  {
   "id": "achor",
   "name": "Anterior choroidal artery",
   "short": "AChA",
   "color": "#06d6a0",
   "territory": "From the internal carotid: optic tract, lateral geniculate, amygdala and hippocampal head, globus pallidus, genu and posterior limb of the internal capsule (textbook), choroid plexus of the temporal horn."
  },
  {
   "id": "lenti",
   "name": "Lenticulostriate arteries",
   "short": "Lenticulostriates",
   "color": "#b5179e",
   "territory": "Penetrating branches of the MCA (M1): putamen, caudate, globus pallidus, internal capsule limbs."
  },
  {
   "id": "pcomm",
   "name": "Posterior communicating / thalamoperforating",
   "short": "PComm / thalamoperf.",
   "color": "#8338ec",
   "territory": "Posterior communicating artery and the thalamoperforating branches from P1: anterior and paramedian thalamus, hypothalamus, mammillary bodies, subthalamic nucleus."
  },
  {
   "id": "pontine",
   "name": "Basilar pontine branches",
   "short": "Pontine (basilar)",
   "color": "#118ab2",
   "territory": "Paramedian and short/long circumferential branches of the basilar artery: pons (corticospinal fibres, medial lemniscus, MLF, abducens nucleus)."
  },
  {
   "id": "sca",
   "name": "Superior cerebellar artery",
   "short": "SCA",
   "color": "#ffd166",
   "territory": "Superior cerebellar surface and vermis, deep nuclei, superior cerebellar peduncle, inferior colliculus, rostral lateral pons."
  },
  {
   "id": "aica",
   "name": "Anterior inferior cerebellar artery",
   "short": "AICA",
   "color": "#8ecae6",
   "territory": "Flocculus and anterior inferior cerebellum, middle cerebellar peduncle, facial and vestibulocochlear nuclei (labyrinthine artery)."
  },
  {
   "id": "pica",
   "name": "Posterior inferior cerebellar artery",
   "short": "PICA",
   "color": "#f4845f",
   "territory": "Inferior vermis and tonsil, inferior cerebellar peduncle, lateral medulla (nucleus ambiguus, solitary and spinal trigeminal nuclei, olive)."
  },
  {
   "id": "vert",
   "name": "Vertebral artery",
   "short": "Vertebral",
   "color": "#a7c957",
   "territory": "Joins to form the basilar artery; gives PICA, the anterior and posterior spinal arteries and medullary perforators (medulla)."
  },
  {
   "id": "asa",
   "name": "Anterior spinal artery",
   "short": "Ant. spinal",
   "color": "#e63946",
   "territory": "The ventral half of the spinal cord on both sides, plus part of each dorsal horn and lateral funiculus: both ventral horns, intermediate grey, most sensory tracts (not the dorsal columns) and all the motor tracts. Formed by a branch from each vertebral artery that fuse between the pyramids."
  },
  {
   "id": "psa",
   "name": "Posterior spinal arteries",
   "short": "Post. spinal",
   "color": "#4cc9f0",
   "territory": "A dorsal wedge of cord on its own side: much of the dorsal horn and the whole dorsal column on that side (two small arteries, identified on a picture only)."
  },
  {
   "id": "ica",
   "name": "Internal carotid artery",
   "short": "ICA",
   "color": "#adb5bd",
   "territory": "Trunk of the anterior circulation: gives the ophthalmic, anterior choroidal and posterior communicating arteries, then the ACA and MCA."
  }
 ],
